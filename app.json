{
  "expo": {
    "name": "Toll",
    "slug": "toll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sunhacks.toll"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "toll",
    "plugins": [
      "expo-router",
      [
        "expo-app-blocker",
        {
          "android": {
            "notificationTitle": "Toll",
            "notificationText": "Storm over {appName}"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Toll checks how far you are from home for away-from-home quests. Your location never leaves the phone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Toll reads the handwritten meetup code. The photo is checked on the phone and deleted right away."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Toll counts steps for walking quests."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00A6A6"
        }
      ],
      "./plugins/withBackgroundOnBack"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
